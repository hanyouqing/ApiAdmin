# Copy to backend.secrets.hcl (gitignored). Or set the same via .env.sh.
# Pattern assumes clone path: ~/github.com/<owner>/<Repo>

locals {
  aws_account_id   = "123456789012"
  account_name     = "" # defaults to path-derived github owner
  aws_profile      = "default"
  state_region     = "ap-northeast-1"
  state_bucket     = "my-tfstate-bucket"
  state_lock_table = "my-tfstate-lock"
  state_role_arn   = ""
}
