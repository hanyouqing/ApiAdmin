{
  "name": "apiadmin",
  "version": "0.1.0",
  "description": "A modern API management platform",
  "private": true,
  "type": "module",
  "bin": {
    "apiadmin": "./tools/apiadmin-cli.mjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node Scripts/check-node-version.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd Client && npm run dev",
    "dev:server": "cd Server && npm run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd Client && npm run build",
    "build:server": "cd Server && npm run build",
    "build:docker": "bash scripts/build-docker.sh",
    "install:all": "npm install && cd Client && npm install && cd ../Server && npm install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss,less}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss,less}\"",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cli": "node tools/apiadmin-cli.mjs",
    "seed-demo": "cd Server && npx tsx scripts/seed-demo.mjs",
    "reset-password": "cd Server && npx tsx scripts/reset-password.mjs",
    "check:node": "node scripts/check-node-version.js",
    "check:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "prepare": "husky",
    "precommit": "lint-staged && npm run test:run",
    "fix:audit": "node scripts/fix-npm-audit.js",
    "fix:audit:simple": "bash scripts/fix-npm-audit-simple.sh",
    "fix:security": "node scripts/fix-security-audit.js",
    "generate:icons": "node Scripts/generate-icons-svg.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,scss,less}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "api",
    "management",
    "mock",
    "testing",
    "documentation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.20.4",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "form-data": ">=4.0.4",
    "jpeg-js": ">=0.4.4",
    "minimist": ">=1.2.8",
    "tough-cookie": ">=4.1.3",
    "url-regex": "npm:url-regex-safe@^4.0.0",
    "brace-expansion": "^2.1.7",
    "minimatch": "^9.0.5",
    "js-yaml": "^4.1.1",
    "nanoid": "^3.3.8",
    "picomatch": "^4.0.3",
    "postcss": "^8.5.6",
    "rollup": "^4.63.1",
    "flatted": "^3.3.3",
    "qs": "^6.14.0",
    "follow-redirects": "^1.16.2",
    "fast-uri": "^3.1.9",
    "handlebars": "^4.7.10",
    "uuid": "^11.1.1",
    "tmp": "^0.2.7",
    "ws": "^8.21.3",
    "cross-spawn": "^7.0.6",
    "shell-quote": "^1.10.0",
    "sharp": "^0.35.5"
  }
}
