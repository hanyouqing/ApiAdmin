# ============================================
# ApiAdmin 环境变量配置示例
# ============================================
# 复制此文件为 .env.local 或 .env 并根据实际情况修改
# 生产环境请使用强随机密钥，禁止使用示例值

# ============================================
# 应用基础配置
# ============================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Docker/K8s 中建议显式设置项目根目录
# APP_ROOT=/app

# ============================================
# 数据库配置（必需）
# ============================================
MONGODB_URL=mongodb://localhost:27017/apiadmin

# ============================================
# JWT 认证配置（必需）
# 生产环境要求长度 >= 32 的随机字符串
# 生成示例: openssl rand -base64 48
# ============================================
JWT_SECRET=dev-only-replace-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d

# ============================================
# Redis 配置（生产环境必需）
# ============================================
# REDIS_URL=redis://:password@localhost:6379
# 生产默认要求 Redis；单机应急可设 REQUIRE_REDIS=false
# REQUIRE_REDIS=true

# ============================================
# 密钥加密（AI / SSO 敏感字段）
# 未设置时派生自 JWT_SECRET；生产建议独立密钥
# 生成示例: openssl rand -base64 32
# ============================================
# SECRETS_ENCRYPTION_KEY=

# ============================================
# CORS 配置（生产必须为明确 Origin，禁止 *）
# 多个 Origin 用逗号分隔
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# 注册与出站安全
# ============================================
# 生产默认关闭公开注册；开发默认允许
ALLOW_PUBLIC_REGISTRATION=true
# 接口调试出站是否允许访问内网地址（生产建议 false）
ALLOW_PRIVATE_OUTBOUND=false
# 自定义 Mock 脚本（生产默认禁用；启用需同时设置 ALLOW_UNSAFE_MOCK_SCRIPTS=true）
ALLOW_MOCK_SCRIPTS=false
ALLOW_UNSAFE_MOCK_SCRIPTS=false
# 受监管模式：强制关闭 mock 脚本；云端 AI 默认禁用（可用 ALLOW_CLOUD_AI=true 放行）
# REGULATED=false
# ALLOW_CLOUD_AI=false

# ============================================
# 文件上传配置
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info

# ============================================
# Swagger API 文档配置（生产建议关闭）
# ============================================
SWAGGER_ENABLED=false
SWAGGER_ALLOWED_IP_ADDRESSES=127.0.0.1

# ============================================
# 邮件服务配置（可选）
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@example.com
